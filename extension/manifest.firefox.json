{
  "manifest_version": 2,
  "name": "MyMag",
  "version": "__VERSION__",
  "description": "Select text on any page, press Ctrl+M (or right-click) and read it enlarged with MyMag. Esc closes.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_action": {
    "default_title": "Read selection with MyMag (Ctrl+M)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shortcut.firefox.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "<all_urls>",
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "clipboardRead"
  ],
  "commands": {
    "open-mymag": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Read the selected (or copied) text with MyMag — also works in the PDF viewer"
    }
  },
  "web_accessible_resources": [
    "index.html",
    "static/*",
    "fontawesome/*",
    "icon.png",
    "mymag.png"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "mymag@ghannamzeinab.github.io",
      "strict_min_version": "109.0"
    }
  }
}
